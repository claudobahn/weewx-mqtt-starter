# WeeWX runtime state (config, database, generated reports). Recreated by setup.sh.
/data/

# Mosquitto persistence (runtime).
/mosquitto/data/

# Mosquitto password file (hashed secrets, generated by setup.sh).
/mosquitto/passwd

# Local config: generated MQTT passwords + optional production settings.
/.env

# Production TLS runtime: Caddy's data/config (Let's Encrypt certs) and the
# Mosquitto cert the sidecar maintains (incl. the self-signed bootstrap).
/caddy/data/
/caddy/config/
/mosquitto/certs/

.idea

/backups/

# Local fuzzy-archer checkout, vendored TEMPORARILY for upstream-candidate
# patch development on this sailing-center branch. The Dockerfile installs
# from here (COPY fuzzy-archer/); gitignored because it's a separate repo
# with its own history -- iterate inside it, push to claudobahn/fuzzy-archer.
/fuzzy-archer/
