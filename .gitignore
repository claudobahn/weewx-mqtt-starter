# WeeWX runtime state (config, database, generated reports). Recreated by setup.sh.
/data/

# Mosquitto persistence (runtime).
/mosquitto/data/

# Mosquitto password file (hashed secrets, generated by setup.sh).
/mosquitto/passwd

# Local config: generated MQTT passwords + optional production settings.
/.env

# Production TLS runtime: Caddy's data/config (Let's Encrypt certs) and the
# Mosquitto cert the sidecar maintains (incl. the self-signed bootstrap).
/caddy/data/
/caddy/config/
/mosquitto/certs/

.idea
