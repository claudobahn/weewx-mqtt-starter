# Local, gitignored settings. setup.sh generates the MQTT account passwords here
# on first run (MQTT_OMG_PASS / MQTT_WEEWX_PASS / MQTT_DASH_PASS).
#
# Behind an HTTP proxy? That's a Docker host setting, not a repo one: add a
# "proxies" block to ~/.docker/config.json and Docker applies it to the image
# build automatically.
#
# NOTE: this file and ./data must be kept in sync -- the MQTT passwords here are
# also baked into ./data/weewx.conf at first run. If you delete .env, delete
# ./data too (and vice versa), or WeeWX will fail to authenticate to the broker.
#
# The STATION_* and WEEWX_* settings below are read by configure.py, which runs
# only at first-run bootstrap -- set them before the first ./setup.sh (or on a
# fresh ./data) for changes to take effect.

# --- Station identity (defaults describe the Sailing Center) ----------------
# Quote any value with a space or comma -- setup.sh sources this file.
# STATION_LOCATION="Sailing Center"
# STATION_LATITUDE=37.808
# STATION_LONGITUDE=-122.409
# STATION_ALTITUDE="3, foot"        # "value, unit" -- e.g. "10, meter"

# --- Optional WeeWX knobs ---------------------------------------------------
# WEEWX_DRIVER=simulator            # the demo layer sets this; default = mqtt (MQTTSubscribe driver)
# WEEWX_WS_URL=ws://localhost:9001  # browser -> broker WebSocket; in prod use wss://$DOMAIN
# WEEWX_VERSION=5.3.1               # pin a different WeeWX release (image build arg)

# --- Production TLS profile (docker-compose.prod.yml) -----------------------
# Required when bringing up the production overlay (Caddy + Let's Encrypt).
# DOMAIN must be a public DNS name pointing at this host; ACME_EMAIL is used by
# Let's Encrypt for expiry notices.
# DOMAIN=weather.example.com
# ACME_EMAIL=you@example.com
