# Mosquitto ACLs — least privilege per account. (No secrets here; safe to commit.)
# Passwords live in the gitignored ./passwd, generated by setup.sh.

# OMG / rtl_433 feed (real device, or e2e-test.sh): publish-only.
user omg
topic write home/#

# WeeWX engine: consumes the sensor feed (subscribe driver) and emits loop data.
user weewx
topic read home/#
topic write weather/#

# Browser dashboard (fuzzy-archer skin): read-only, and only the live topic.
# These credentials are embedded in the public weewxData.json, so they must stay
# read-only and narrowly scoped.
user dashboard
topic read weather/loop

# Internal healthcheck (mqtt service's Docker healthcheck): read one retained
# $SYS topic, nothing else. Used only inside the broker container; not exposed.
user health
topic read $SYS/broker/uptime
